    "mcp:billing:http": "MCP_TRANSPORT=http MCP_PORT=4011 node billing-api/mcp-server.js",
    "reset": "npm run down && npm run up && npm run seed"
  },
  "dependencies": {
    "@faker-js/faker": "^9.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^4.19.2",
    "minio": "^8.0.1",
