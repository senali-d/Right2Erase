{
  "name": "shopkart-fixture",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A fake company for the erasure agent to work on. All data is generated.",
  "scripts": {
    "up": "docker compose up -d --wait",
    "down": "docker compose down -v",
    "seed": "node scripts/seed.js",
    "truth": "node scripts/truth.js",
