{
  "name": "shopkart-fixture",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A fake company for the erasure agent to work on. All data is generated.",
  "scripts": {
    "up": "docker compose -f ../docker-compose.yml up -d --wait",
    "down": "docker compose -f ../docker-compose.yml down -v",
    "seed": "node --env-file-if-exists=../.env scripts/seed.js",
    "truth": "node --env-file-if-exists=../.env scripts/truth.js",
    "mcp:billing": "node ../mcp/billing-server.js",
    "mcp:billing:http": "MCP_TRANSPORT=http MCP_PORT=4011 node ../mcp/billing-server.js",
    "reset": "npm run down && npm run up && npm run seed"
  },
  "dependencies": {
    "@faker-js/faker": "^9.0.0",
    "minio": "^8.0.1",
    "pg": "^8.12.0"
  }
}
