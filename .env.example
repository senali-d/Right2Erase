DATABASE_URL=postgres://shopkart:shopkart@localhost:5432/shopkart
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=shopkart
MINIO_SECRET_KEY=shopkart123
MINIO_BUCKET=shopkart-uploads
BILLING_URL=http://localhost:4010
MCP_PORT=4011
MCP_DB_PORT=4012
MCP_STORAGE_PORT=4013
OUBLIETTE_MCP_PORT=4014
# Required by each MCP server for non-loopback HTTP; leave blank for local loopback dev.
# The agent client (agent/create-agent.js) also reads this as the bearer token it sends
# to every server, so one MCP_AUTH_TOKEN value here covers the common single-shared-token
# setup. If a server is issued its own distinct secret instead, set that server's token
# only on MCP_AUTH_TOKEN_<NAME> (e.g. MCP_AUTH_TOKEN_DATABASE, MCP_AUTH_TOKEN_STORAGE,
# MCP_AUTH_TOKEN_BILLING, MCP_AUTH_TOKEN_OUBLIETTE) and the client will send that instead
# of the shared MCP_AUTH_TOKEN when calling that server.
MCP_AUTH_TOKEN=
MCP_TRUSTED_ORIGINS=http://localhost:4011,http://127.0.0.1:4011
CASE_STORE_PATH=.oubliette/cases
# Directory the ShopKart db MCP server writes db_export_subject_snapshot files
# to and db_rehearse_deletion_plan is confined to.
OUBLIETTE_SANDBOX_DIR=.oubliette/sandbox

# TrueForge harness (agentic engine). The server itself:
#   npx @truefoundry/trueforge@latest
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_AGENT=oubliette-erasure

# Model credential for the agentic engine. Copy this file to .env (gitignored)
# and put the real key there - never here. scripts/trueforge-bootstrap.mjs
# passes it to TrueForge, which stores it in its own settings; nothing in this
# repo writes it to disk.
OPENAI_API_KEY=

# Which engine drives an investigation when the request does not say.
# 'agentic' (default) or 'deterministic'.
OUBLIETTE_ENGINE=agentic
