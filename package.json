{
  "name": "oubliette",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "fixture",
    "web"
  ],
  "scripts": {
    "setup": "npm install && npm run up && npm run seed",
    "dev": "./scripts/dev-all.sh",
    "web:dev": "npm --workspace oubliette-web run dev",
    "web:build": "npm --workspace oubliette-web run build",
    "web:start": "npm --workspace oubliette-web run start",
    "up": "docker compose up -d --wait",
    "down": "docker compose down -v",
    "seed": "npm --workspace fixture run seed",
    "truth": "node --env-file-if-exists=.env fixture/scripts/truth.js",
    "reset": "npm run down && npm run up && npm run seed",
    "mcp:billing": "node mcp/billing-server.js",
    "mcp:billing:http": "MCP_TRANSPORT=http MCP_PORT=4011 node mcp/billing-server.js",
    "mcp:db": "node mcp/database-server.js",
    "mcp:db:http": "MCP_TRANSPORT=http node mcp/database-server.js",
    "mcp:storage": "node mcp/storage-server.js",
    "mcp:storage:http": "MCP_TRANSPORT=http node mcp/storage-server.js",
    "mcp:oubliette": "node src/mcp-server.js",
    "mcp:oubliette:http": "MCP_TRANSPORT=http node src/mcp-server.js",
    "mcp:all": "node scripts/mcp-all.js",
    "test": "node --test && npm --workspaces run test --if-present"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^11.10.0",
    "express": "^4.19.2",
    "minio": "^8.0.7",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  }
}
